{
  "name": "aurora-wechat-relay-ios-web-push-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node scripts/run-server.mjs development",
    "dev:db": "docker compose --env-file .env.development -f compose.development.yml up -d",
    "test": "npm run build && node --test dist/*.test.js scripts/*.test.mjs",
    "start": "node dist/server.js",
    "start:production": "node scripts/run-server.mjs production"
  },
  "dependencies": {
    "mysql2": "3.24.2",
    "redis": "6.2.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/web-push": "3.6.4",
    "typescript": "7.0.2"
  }
}
